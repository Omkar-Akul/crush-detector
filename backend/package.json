{
  "name": "crush-detector-api",
  "version": "1.0.0",
  "description": "Backend API for Mutual Crush Detector - Find out if your crush likes you back!",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:init": "psql -U crush_user -d crush_detector_db -f DATABASE_SCHEMA.sql",
    "db:reset": "psql -U postgres -c \"DROP DATABASE IF EXISTS crush_detector_db; CREATE DATABASE crush_detector_db;\" && npm run db:init",
    "db:backup": "pg_dump -U crush_user crush_detector_db | gzip > backup-$(date +%Y%m%d-%H%M%S).sql.gz",
    "migrate:latest": "knex migrate:latest",
    "seed": "knex seed:run"
  },
  "keywords": [
    "crush",
    "dating",
    "mutual",
    "love",
    "matchmaking"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.10.2",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.10.0",
    "redis": "^4.6.10",
    "resend": "^6.12.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/crush-detector.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/crush-detector/issues"
  },
  "homepage": "https://github.com/yourusername/crush-detector#readme"
}
